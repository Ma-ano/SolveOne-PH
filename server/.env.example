# Runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database
MONGODB_URI=replace-with-mongodb-atlas-connection-string
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Authentication (replace with independent, high-entropy secrets outside tests)
JWT_ACCESS_SECRET=replace-with-access-token-secret
JWT_REFRESH_SECRET=replace-with-refresh-token-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_HASH_ROUNDS=12
IP_HASH_SECRET=replace-with-ip-hash-secret
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
REFRESH_COOKIE_NAME=solveone_refresh
TERMS_VERSION=development
PRIVACY_VERSION=development
ACCOUNT_CLOSURE_POLICY_VERSION=development
ACCOUNT_CLOSURE_NOTICE_URL=

# Help-request policy (integer centavos; default ceiling is PHP 10,000)
MAX_REQUEST_ESTIMATED_VALUE_CENTAVOS=1000000
MAX_REQUEST_NEED_ITEMS=20

# Offer creation abuse controls
OFFER_RATE_LIMIT_WINDOW_MS=3600000
OFFER_RATE_LIMIT_MAX=20
IDEMPOTENCY_TTL_HOURS=24

# Messaging abuse controls
MESSAGE_RATE_LIMIT_WINDOW_MS=60000
MESSAGE_RATE_LIMIT_MAX=60
EVIDENCE_UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
EVIDENCE_UPLOAD_RATE_LIMIT_MAX=10

# Client and transport
FRONTEND_URL=http://localhost:8081
MOBILE_SCHEME=solveone
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
TRUST_PROXY=0
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
EMAIL_ACTION_RATE_LIMIT_MAX=5
SHUTDOWN_TIMEOUT_MS=10000

# Private S3-compatible object storage (required in production; keep the bucket private)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret
IDENTITY_PROCESSING_ENABLED=false
IDENTITY_PRIVACY_NOTICE_VERSION=
IDENTITY_PRIVACY_NOTICE_URL=
IDENTITY_SCANNER_SOCKET=
IDENTITY_SCANNER_PORT=0

# Email provider
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.invalid
EMAIL_API_KEY=replace-with-email-provider-key

# Platform-donation provider (Phase 10; not recipient payments)
PAYMENT_PROVIDER=
PAYMENT_ENABLED=false
PAYMENT_MODE=test
PAYMENT_SECRET_KEY=replace-with-payment-provider-secret
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-signing-secret
PAYMENT_METHOD_TYPES=card,gcash,qrph

# Optional request-structuring assistance (disabled by default; server-side only)
AI_ASSISTANCE_ENABLED=false
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_SAFETY_IDENTIFIER_SECRET=replace-with-independent-ai-safety-secret
AI_REQUEST_RATE_LIMIT_WINDOW_MS=3600000
AI_REQUEST_RATE_LIMIT_MAX=5
AI_PROVIDER_TIMEOUT_MS=10000
